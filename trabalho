import itertools
import time

# --- CONFIGURAÇÃO INICIAL (Dica 1) ---
# Usando um conjunto pequeno de caracteres (letras minúsculas) e uma senha curta
CARACTERES = "abcdefghijklmnopqrstuvwxyz"
SENHA_ALVO = "cat"  # Você pode mudar para testar, ex: "a", "ab", "cat"
MAX_CARACTERES = 3


def brute_force_attack(senha_secreta, caracteres_disponiveis, tamanho_max):
    print(f"Iniciando tentativa de força bruta para a senha: '{senha_secreta}'")
    print(f"Caracteres utilizados: {caracteres_disponiveis}\n")

    tentativas_totais = 0
    inicio_tempo = time.time()

    # Testa comprimentos de 1 até o tamanho máximo definido (1, 2, 3)
    for tamanho in range(1, tamanho_max + 1):
        print(f"--> Testando combinações de tamanho {tamanho}...")

        # Dica 2: itertools.product gera as combinações (tuplas)
        for combinacao_tupla in itertools.product(
            caracteres_disponiveis, repeat=tamanho
        ):
            # Dica 3: Transforma a tupla em uma string (palavra)
            tentativa = "".join(combinacao_tupla)
            tentativas_totais += 1

            # Mostra o progresso das tentativas na tela
            print(f"Tentativa #{tentativas_totais}: {tentativa}")

            # Verifica se a tentativa é igual à senha alvo
            if tentativa == senha_secreta:
                fim_tempo = time.time()
                tempo_gasto = fim_tempo - inicio_tempo

                print("\n[SUCESSO] Senha encontrada!")
                print(f"A senha é: '{tentativa}'")
                print(f"Total de tentativas: {tentativas_totais}")
                print(f"Tempo gasto: {tempo_gasto:.4f} segundos.")
                return True

    print("\n[FALHA] A senha não foi encontrada com as configurações atuais.")
    return False


# Executa o desafio
brute_force_attack(SENHA_ALVO, CARACTERES, MAX_CARACTERES)
